// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusDevis {
  Accepter
  Annuler
  EnCours
  Archive
}

enum TacheEtat {
  OK
  NOK
}

enum ProjectsTachesEtat {
  AFaire
  EnCours
  Termine
}

model Clients {
  id                        String          @id @default(cuid())
  code                      String
  companyName               String
  companyDescription        String
  logo                      String?
  adresse                   String
  postal                    String
  city                      String
  pays                      String
  telephone                 String
  email                     String
  date                      DateTime
  contacts                  Contacts[]
  Devis                     Devis[]
  projets                   Projects[]
  factures                  Factures[]
}

model Contacts {
  id                        String        @id @default(cuid()) 
  firstname                 String
  lastname                  String
  role                      String
  email                     String
  telephone                 String?
  client                    Clients[]
}

model Devis {
  id                        String        @id @default(cuid()) 
  number                    String
  indice                    String
  title                     String
  designation               String
  client                    Clients[]
  status                    StatusDevis     @default(EnCours)
}

model Projects {
  id                        String        @id @default(cuid()) 
  number                    String
  indice                    String 
  name                      String
  designation               String
  client                    Clients[]
  taches                    ProjetcsTaches[]
}

model ProjetcsTaches {
  id                        String        @id @default(cuid())
  title                     String
  designation               String
  project                   Projects[]
  etat                      ProjectsTachesEtat     @default(AFaire)
}

model Factures {
  id                        String        @id @default(cuid())
  number                    String
  indice                    String
  title                     String
  designation               String
  client                    Clients[]
}

model Taches {
  id                        String        @id @default(cuid())
  title                     String
  designation               String
  client                    String
  etat                      TacheEtat     @default(NOK)
}